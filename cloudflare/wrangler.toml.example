name = "abo-data-freshness-monitor"
main = "worker.mjs"
compatibility_date = "2026-10-27"

[triggers]
crons = ["17,47 * * * *"]

[vars]
FEED_URL = "https://chakhan82.github.io/abo-data/data/briefing.json"
GITHUB_OWNER = "chakhan82"
GITHUB_REPO = "abo-data"
GITHUB_WORKFLOW = "publish.yml"
GITHUB_REF = "main"
MAX_DATA_AGE_MINUTES = "50"

# Set secrets separately; never commit their values:
# npx wrangler secret put GITHUB_TOKEN
# Optional: npx wrangler secret put ALERT_WEBHOOK_URL
